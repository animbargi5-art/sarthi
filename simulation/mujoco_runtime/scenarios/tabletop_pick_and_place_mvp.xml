<mujoco model="sarthi_tabletop_pick_and_place">
  <compiler angle="radian" autolimits="true" />

  <option integrator="implicitfast" timestep="0.002" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="120" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <material name="table_mat" rgba="0.35 0.35 0.38 1" specular="0.2" shininess="0.1" />
    <material name="red_object_mat" rgba="0.85 0.15 0.15 1" specular="0.4" shininess="0.3" />
    <material name="blue_target_mat" rgba="0.15 0.35 0.85 0.6" specular="0.1" />
    <material name="obstacle_mat" rgba="0.95 0.55 0.10 1" specular="0.3" />
  </asset>

  <include file="panda.xml" />

  <worldbody>
    
    <light pos="0 0 2.0" dir="0 0 -1" directional="true" />
    <light pos="1.0 1.0 2.0" dir="-0.5 -0.5 -1" directional="false" diffuse="0.4 0.4 0.4" />

    
    <camera name="sarthi_demo_cam" pos="1.15 0.45 0.85" fovy="55" mode="targetbody" target="table" />

    
    <geom name="floor" size="2 2 0.05" type="plane" material="groundplane" />

    
    <body name="table" pos="0.35 0.0 0.085">
      <geom name="tabletop" type="box" size="0.45 0.50 0.085" material="table_mat" />
    </body>

    
    <body name="red_object" pos="0.25 0.15 0.20">
      <freejoint name="red_object_joint" />
      <inertial mass="0.5" pos="0 0 0" diaginertia="0.0004 0.0004 0.0003" />
      <geom name="red_object_geom" type="cylinder" size="0.025 0.03" material="red_object_mat" friction="5.0 0.1 0.005" solref="0.005 1" solimp="0.95 0.99 0.001" />
    </body>

    
    <body name="blue_target" pos="0.40 -0.20 0.171">
      <geom name="blue_target_zone" type="cylinder" size="0.06 0.001" material="blue_target_mat" contype="0" conaffinity="0" />
    </body>

    
    <body name="obstacle" pos="0.325 -0.025 0.21">
      <geom name="obstacle_geom" type="box" size="0.03 0.03 0.04" material="obstacle_mat" mass="5.0" friction="1.0 0.05 0.001" />
    </body>
  </worldbody>

  <contact>
    <pair geom1="tabletop" geom2="red_object_geom" friction="1.2 1.2 0.01 0.01 0.01" />
    <exclude body1="table" body2="link0" /><exclude body1="table" body2="link1" /><exclude body1="table" body2="link2" /><exclude body1="table" body2="link3" /><exclude body1="table" body2="link4" /><exclude body1="table" body2="link5" /><exclude body1="table" body2="link6" /><exclude body1="table" body2="link7" /><exclude body1="table" body2="hand" /><exclude body1="table" body2="left_finger" /><exclude body1="table" body2="right_finger" /></contact>
</mujoco>